---
import Layout from '../layouts/Layout.astro';
import LogoShowcase from '../components/LogoShowcase.jsx';
import '../styles/tailwind.css';
---

<Layout title="Apex Motors - Automotive Excellence">
  <!-- Hero Section -->
  <section class="relative w-full h-screen flex items-center justify-center overflow-hidden bg-black">
    <!-- Animated Gradient Background -->
    <div class="absolute inset-0 bg-gradient-to-br from-black via-purple-900/20 to-black">
      <!-- Animated Stars -->
      <div class="stars absolute"></div>
    </div>

    <!-- 3D Logo Showcase -->
    <div class="relative z-10 w-96 h-96 md:w-[20rem] md:h-[20rem]">
      <LogoShowcase />
    </div>

    <!-- Content -->
    <div class="absolute bottom-20 left-1/2 transform -translate-x-1/2 z-10 text-center">
      <h1 class="text-6xl md:text-8xl font-bold text-white mb-6">
        APEX
        <span class="block text-3xl md:text-4xl text-apex-dark mt-2">MOTORS</span>
      </h1>
      <p class="text-xl text-gray-400 mb-8 max-w-2xl mx-auto">
        Experience automotive excellence with cutting-edge performance and stunning design
      </p>
      <button class="px-8 py-4 bg-apex-dark text-white font-semibold rounded-full hover:bg-apex-light transition-all duration-300 transform hover:scale-105">
        Explore Our Collection
      </button>
    </div>
  </section>

  <!-- Video Showcase Section -->
  <section class="relative py-24 px-4 bg-black">
    <div class="max-w-7xl mx-auto">
      <h2 class="text-4xl md:text-5xl font-bold text-center text-white mb-16">
        Watch Our Story
      </h2>

      <!-- Video Grid -->
      <div class="grid md:grid-cols-2 gap-8">
        <!-- Video Item 1 -->
        <div class="grouprelative bg-gradient-to-br from-gray-900 to-black rounded-2xl overflow-hidden transform hover:scale-[1.02] transition-all duration-500">
          <div class="relative aspect-video bg-gradient-to-br from-gray-800 to-gray-900 flex items-center justify-center">
            <div class="text-center p-6">
              <div class="w-24 h-24 bg-apex-dark rounded-full flex items-center justify-center mx-auto mb-4 shadow-2xl">
                <svg class="w-10 h-10 text-white" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z"/>
                </svg>
              </div>
              <p class="text-gray-300">Main Showroom Video</p>
            </div>
          </div>
          <div class="p-6">
            <h3 class="text-2xl font-bold text-white mb-2">Main Showroom</h3>
            <p class="text-gray-400">Explore our premium vehicle collection in an immersive environment.</p>
          </div>
        </div>

        <!-- Video Item 2 -->
        <div class="grouprelative bg-gradient-to-br from-gray-900 to-black rounded-2xl overflow-hidden transform hover:scale-[1.02] transition-all duration-500">
          <div class="relative aspect-video bg-gradient-to-br from-gray-800 to-gray-900 flex items-center justify-center">
            <div class="text-center p-6">
              <div class="w-24 h-24 bg-apex-dark rounded-full flex items-center justify-center mx-auto mb-4 shadow-2xl">
                <svg class="w-10 h-10 text-white" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z"/>
                </svg>
              </div>
              <p class="text-gray-300">Engine Detail Video</p>
            </div>
          </div>
          <div class="p-6">
            <h3 class="text-2xl font-bold text-white mb-2">Engine Detail</h3>
            <p class="text-gray-400">Discover the engineering excellence behind our performance engines.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    .stars {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: transparent;
      box-shadow:
        0 0 2px rgba(255, 255, 255, 0.8),
        50px 50px 2px rgba(255, 255, 255, 0.6),
        100px 100px 2px rgba(255, 255, 255, 0.4),
        150px 150px 2px rgba(255, 255, 255, 0.2),
        200px 200px 2px rgba(255, 255, 255, 0.1),
        250px 250px 2px rgba(255, 255, 255, 0.05),
        300px 300px 2px rgba(255, 255, 255, 0.03),
        350px 350px 2px rgba(255, 255, 255, 0.02);
      animation: twinkle 3s infinite;
    }

    @keyframes twinkle {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.5; }
    }

    @media (max-width: 768px) {
      .stars {
        background: transparent;
        box-shadow:
          0 0 1px rgba(255, 255, 255, 0.6),
          25px 25px 1px rgba(255, 255, 255, 0.4),
          50px 50px 1px rgba(255, 255, 255, 0.2),
          75px 75px 1px rgba(255, 255, 255, 0.1);
      }
    }
  </style>
</Layout>