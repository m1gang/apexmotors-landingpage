---
import Layout from "../layouts/Layout.astro";
import LogoApex from "../assets/svg/APEX-LOGO-2.svg";
---

<Layout title="Apex Motors - Ingeniería de Precisión">
  <section class="relative flex min-h-dvh flex-col items-center justify-center bg-apex-dark px-6 text-apex-light">
    <LogoApex
      class="mb-14 h-auto w-60 sm:w-72 md:w-80"
      role="img"
      aria-label="Apex Motors"
    />

    <h1 class="max-w-3xl text-balance text-center text-4xl font-light leading-[1.1] tracking-[-0.04em] sm:text-5xl md:text-7xl">
      El rendimiento automotriz en su forma más pura.
    </h1>

    <button
      type="button"
      class="mt-10 border border-apex-light/40 px-8 py-3 text-[10px] uppercase tracking-widest transition-colors duration-300 hover:border-apex-brand hover:bg-apex-brand focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-apex-brand md:text-xs"
    >
      Descubrir la ingeniería
    </button>
  </section>

  <!-- Video Showcase Section -->
  <section class="relative py-24 px-4 bg-apex-dark">
    <div class="max-w-7xl mx-auto">
      <h2 class="text-4xl md:text-5xl font-bold text-center text-apex-light mb-16">
        Watch Our Story
      </h2>

      <!-- Video Grid -->
      <div class="grid md:grid-cols-2 gap-8">
        <!-- Video Item 1 -->
        <div class="grouprelative bg-gradient-to-br from-apex-light/10 to-apex-dark rounded-2xl overflow-hidden transform hover:scale-[1.02] transition-all duration-500">
          <div class="relative aspect-video bg-gradient-to-br from-apex-light/15 to-apex-light/5 flex items-center justify-center">
            <div class="text-center p-6">
              <div class="w-24 h-24 bg-apex-brand rounded-full flex items-center justify-center mx-auto mb-4 shadow-2xl">
                <svg class="w-10 h-10 text-apex-light" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z" />
                </svg>
              </div>
              <p class="text-apex-light/80">Main Showroom Video</p>
            </div>
          </div>
          <div class="p-6">
            <h3 class="text-2xl font-bold text-apex-light mb-2">Main Showroom</h3>
            <p class="text-apex-light/60">
              Explore our premium vehicle collection in an immersive
              environment.
            </p>
          </div>
        </div>

        <!-- Video Item 2 -->
        <div class="grouprelative bg-gradient-to-br from-apex-light/10 to-apex-dark rounded-2xl overflow-hidden transform hover:scale-[1.02] transition-all duration-500">
          <div class="relative aspect-video bg-gradient-to-br from-apex-light/15 to-apex-light/5 flex items-center justify-center">
            <div class="text-center p-6">
              <div class="w-24 h-24 bg-apex-brand rounded-full flex items-center justify-center mx-auto mb-4 shadow-2xl">
                <svg class="w-10 h-10 text-apex-light" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z" />
                </svg>
              </div>
              <p class="text-apex-light/80">Engine Detail Video</p>
            </div>
          </div>
          <div class="p-6">
            <h3 class="text-2xl font-bold text-apex-light mb-2">Engine Detail</h3>
            <p class="text-apex-light/60">
              Discover the engineering excellence behind our performance
              engines.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
