---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        darkMode: 'class',
        theme: {
          extend: {
            colors: {
              apex: {
                light: '#E1E7F5',
                dark: '#BE4B6B'
              }
            }
          }
        }
      }
    </script>
  </head>
  <body class="bg-black text-white">
    <slot />
  </body>
</html>